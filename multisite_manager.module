/**
 * Implements hook_entity_presave().
 */
function multisite_manager_entity_presave(
  \Drupal\Core\Entity\EntityInterface $entity,
) {
  if ($entity instanceof SiteInterface) {
    // Log when a site is about to be saved with published status change
    if (
      $entity->isNew() ||
      $entity->published() !== $entity->original->published()
    ) {
      if ($entity->published()) {
        \Drupal::logger("multisite_manager")->info(
          "Site @domain is being published and will be queued for cloning.",
          [
            "@domain" => $entity->domain(),
          ],
        );
      } else {
        \Drupal::logger("multisite_manager")->info(
          "Site @domain is being unpublished.",
          [
            "@domain" => $entity->domain(),
          ],
        );
      }
    }
  }
}

/**
 * Get the site cloning queue manager service.
 *
 * @return \Drupal\multisite_manager\SiteCloningQueueManager
 *   The site cloning queue manager service.
 */
function multisite_manager_get_queue_manager()
{
  return \Drupal::service("multisite_manager.site_cloning_queue_manager");
}

/**
 * Check if a site is currently being cloned.
 *
 * @param \Drupal\multisite_manager\SiteInterface $site
 *   The site entity.
 *
 * @return bool
 *   TRUE if the site is being cloned, FALSE otherwise.
 */
function multisite_manager_is_site_cloning(SiteInterface $site)
{
  $queue_manager = multisite_manager_get_queue_manager();
  return $queue_manager->isSiteBeingCloned($site);
}

/**
 * Get the current queue size.
 *
 * @return int
 *   The number of items in the site cloning queue.
 */
function multisite_manager_get_queue_size()
{
  $queue_manager = multisite_manager_get_queue_manager();
  return $queue_manager->getQueueSize();
}
