<?php

/**
 * @file
 * Contains multisite_manager.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\multisite_manager\SiteInterface;

/**
 * Implements hook_help().
 */
function multisite_manager_help($route_name, RouteMatchInterface $route_match)
{
  switch ($route_name) {
    // Main module help for the multisite_manager module.
    case "help.page.multisite_manager":
      $output = "";
      $output .= "<h3>" . t("About") . "</h3>";
      $output .=
        "<p>" .
        t("Manages multiple Drupal sites with queue-based cloning system.") .
        "</p>";
      $output .= "<h3>" . t("Queue Management") . "</h3>";
      $output .=
        "<p>" .
        t(
          "Site cloning is now handled through a queue system for better performance and reliability.",
        ) .
        "</p>";
      $output .= "<ul>";
      $output .=
        "<li>" .
        t(
          "Use <code>drush multisite:queue:status</code> to check queue status",
        ) .
        "</li>";
      $output .=
        "<li>" .
        t(
          "Use <code>drush multisite:queue:process</code> to process queue items manually",
        ) .
        "</li>";
      $output .=
        "<li>" .
        t("Ensure cron is running regularly for automatic processing") .
        "</li>";
      $output .= "</ul>";
      return $output;

    default:
  }
}

